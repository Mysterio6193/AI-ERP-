# SupplySure OS — environment reference
# Copy to .env and fill in. NEVER commit the real .env.

# ── Required ────────────────────────────────────────────────────────────────
# SQLite (dev): file:./db/dev.db resolves relative to prisma/schema.prisma.
# Postgres (planned): postgresql://user:pass@localhost:5432/supplysure
DATABASE_URL="file:./db/dev.db"

# Session signing secrets. In production these MUST be set to long random
# values — the app refuses to boot on the dev fallbacks (see src/lib/env-guard.ts).
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=""
DRIVER_SESSION_SECRET=""

# Shared secret for the external scheduler calling /api/cron/agents.
CRON_SECRET=""

# ── Development conveniences (never set in production) ─────────────────────
# Skips the sign-in gate entirely. Guarded: warns under NODE_ENV=production.
AUTH_BYPASS="true"
# Returns OTP codes in register/resend responses (no SMS provider in dev).
CUSTOMER_OTP_EXPOSE="true"
# Logs every Prisma query (row data included) — debugging only.
PRISMA_LOG_QUERIES="false"

# ── Agent model (local inference — Muse Glimmer / Ollama, OpenAI-compatible) ─
AGENT_PROVIDER="local"
AGENT_LOCAL_BASE_URL="http://localhost:11434/v1"
AGENT_LOCAL_MODEL=""
AGENT_LOCAL_FAST_MODEL=""
AGENT_LOCAL_API_KEY=""
# Or via Vercel AI Gateway:
# AI_GATEWAY_API_KEY=""
# AGENT_MODEL="anthropic/claude-sonnet-5"
# AGENT_FAST_MODEL="anthropic/claude-haiku-4.5"

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── SMTP (outbound email) ───────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=""

# ── Agent channels ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
AGENT_EMAIL=""
AGENT_PHONE=""
# Shared secret for the inbound email webhook (api/agent/email).
INBOUND_EMAIL_SECRET=""

# ── Customer storefront (CORS origins allowed to call /api/user + /api/order) ─
CUSTOMER_WEB_ORIGIN=""
CUSTOMER_APP_ORIGIN=""

# ── Driver app (apps/driver-app) ────────────────────────────────────────────
# Server-side proxy target for the core app's API.
CORE_APP_URL="http://localhost:3000"

# ── Fallbacks (do not set unless you know why) ──────────────────────────────
# NEXTAUTH_SECRET — legacy fallback for both session secrets if the specific
# ones above are unset.
