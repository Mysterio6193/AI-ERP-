# SupplySure OS — environment
#
# Copy to .env and fill in. `bun scripts/preflight.ts` reports what is missing
# and what each gap would actually break.
#
# Generate any secret below with:
#   openssl rand -base64 48


# ── Required in production ───────────────────────────────────────────────────

# Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/supplysure"

# Signs staff session cookies. Without it, sessions are signed with a value
# published in this repository and anyone who has read it can forge one.
ADMIN_SESSION_SECRET=""

# Signs driver app sessions. NEXTAUTH_SECRET is accepted as a fallback; if
# neither is set the app refuses to start in production rather than mint
# forgeable tokens.
DRIVER_SESSION_SECRET=""


# ── Strongly recommended ─────────────────────────────────────────────────────

# Outbound mail. With no transport configured, invoices, order confirmations
# and statements are recorded as sent and reach nobody — the failure looks
# exactly like success.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME=""

# Lets the scheduler run agents from cron. Without it, scheduled agents only
# run when a signed-in admin triggers them — so nothing runs overnight.
CRON_SECRET=""

# Model access for every agent feature. Any one credential is enough.
AGENT_PROVIDER="openrouter"
AI_GATEWAY_API_KEY=""
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Default models (vendor/model-name).
AGENT_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
AGENT_FAST_MODEL="nvidia/nemotron-3.5-lightning:free"

# Per-purpose overrides. Each falls back to AGENT_MODEL when unset.
AGENT_MODEL_TELEGRAM="nvidia/nemotron-3-super-120b-a12b:free"
AGENT_MODEL_REPLENISHMENT="nvidia/nemotron-3-super-120b-a12b:free"
AGENT_MODEL_EMAIL="nvidia/nemotron-3.5-lightning:free"
AGENT_MODEL_FINANCE="nvidia/nemotron-3-ultra-550b-a55b:free"
AGENT_MODEL_OCR="nvidia/nemotron-nano-12b-v2-vl:free"
AGENT_MODEL_VOICE="nvidia/nemotron-nano-12b-v2-vl:free"


# ── Integrations (only if you use them) ──────────────────────────────────────

# Payments. The webhook refuses unverified traffic, so without the webhook
# secret payment confirmations never arrive and orders are never marked paid.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Telegram channel. The webhook verifies this secret header, so inbound
# messages are refused without it.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Addresses the agent presents as on outbound channels.
AGENT_EMAIL=""
AGENT_PHONE=""

# Inbound email webhook shared secret.
INBOUND_EMAIL_SECRET=""

# Storefront origins allowed to call the customer API (CORS).
CUSTOMER_WEB_ORIGIN=""
CUSTOMER_APP_ORIGIN=""


# ── Driver app (apps/driver-app) ─────────────────────────────────────────────

# Server-side proxy target for the core app's API.
CORE_APP_URL="http://localhost:3000"


# ── Development only ─────────────────────────────────────────────────────────

# Hands every unauthenticated request a synthetic admin, so every guard in the
# platform passes whether or not it works. It cannot activate in a production
# build, but leave it off while testing anything auth-related — with it on, a
# broken guard is indistinguishable from a working one.
AUTH_BYPASS="false"

# Returns the sign-up code in the API response instead of emailing it. Fatal in
# production: anyone could verify any address without receiving the code.
CUSTOMER_OTP_EXPOSE="false"

# Logs every SQL statement.
PRISMA_LOG_QUERIES="false"
