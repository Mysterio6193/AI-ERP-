# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output (any app in the repo)
.next/
out/

# production
/build

# databases — never commit SQLite files or their sidecars
*.db
*.db-journal
*.db-wal
*.db-shm

# uploads written at runtime (driver proof-of-delivery photos etc.)
public/uploads/

# binary artifacts / ad-hoc archives
*.zip

# scratch directories
/upload/
/download/

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — .env.example IS committed so the required vars are documented
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*

# local AI-tooling config
.claude
.codex

# Skills directory
/skills/
